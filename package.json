{
  "name": "so7ob-dash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "owner-password": "node server/password.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.*",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
