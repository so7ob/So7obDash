# Local demo. npm start reads .env if present; process environment takes
# precedence. For live operation prefer a private service EnvironmentFile.
SO7OB_MODE=demo
HOST=127.0.0.1
PORT=3086

# Required for live mode. Set SO7OB_MODE=live; never publish demo as live.
# PUBLIC_ORIGIN=https://dashboard.example.com
# OWNER_PASSWORD_SCRYPT=<hex-salt>:<hex-hash>
# GITHUB_APP_ID=<GitHub App ID, not the client ID>
# GITHUB_PRIVATE_KEY_FILE=/etc/so7obdash/github-app.pem
# GITHUB_INSTALLATION_IDS=<installation-id>[,<another-installation-id>]
# GITHUB_WEBHOOK_SECRET=<strong-independent-random-secret-at-least-32-characters>

# Optional committed scope: stable repo ID to GitHub milestone number; blank hides progress.
GITHUB_PROGRESS_MILESTONES=
